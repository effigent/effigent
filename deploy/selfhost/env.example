# Copy to .env next to compose.yaml. Keep .env out of version control and back
# it up: it holds the policy signing key.

# Two DNS names pointing at this VM.
EFFIGENT_API_HOST=effigent-api.example.com
EFFIGENT_CONSOLE_HOST=effigent.example.com
# EFFIGENT_CADDY_TLS="tls internal"        # private network: Caddy's own CA

# Image versions (effigent-cp and effigent-console are released together).
EFFIGENT_VERSION=latest

# Your identity provider. Register a client for the console with redirect URI
#   https://<EFFIGENT_CONSOLE_HOST>/auth/callback
# and post-logout redirect https://<EFFIGENT_CONSOLE_HOST>/sign-in?signed_out=1
EFFIGENT_OIDC_ISSUER=https://login.example.com
EFFIGENT_OIDC_CLIENT_ID=effigent-console
EFFIGENT_OIDC_CLIENT_SECRET=
EFFIGENT_OIDC_PROVIDER_NAME=Okta
# EFFIGENT_OIDC_SCOPES=openid email profile offline_access groups
# Roles: admin > security_admin > viewer (everyone else who signs in).
EFFIGENT_OIDC_ADMIN_GROUPS=effigent-admins
EFFIGENT_OIDC_SECURITY_ADMIN_GROUPS=
EFFIGENT_OIDC_ADMIN_EMAILS=
# EFFIGENT_OIDC_ALLOWED_GROUPS=engineering   # refuse everyone else
# EFFIGENT_OIDC_GROUPS_CLAIM=groups

# Keys. Generate each once:
#   openssl rand -base64 32   -> EFFIGENT_SIGNING_KEY  (NEVER change it: machines pin it)
#   openssl rand -hex 24      -> the others
EFFIGENT_SIGNING_KEY=
EFFIGENT_SECRETS_KEY=
EFFIGENT_SESSION_SECRET=
POSTGRES_PASSWORD=
# Automation: Authorization: Bearer <token> + X-Effigent-Tenant: org:self-hosted
EFFIGENT_ADMIN_TOKEN=

# Approval and alert emails (optional).
# EFFIGENT_SMTP_URL=smtp://user:pass@smtp.example.com:587
# EFFIGENT_EMAIL_FROM=Effigent <effigent@example.com>

# Event archive before retention deletes (optional; S3 or S3-compatible).
# EFFIGENT_ARCHIVE_BUCKET=effigent-events
# EFFIGENT_ARCHIVE_ENDPOINT=https://minio.example.com
# EFFIGENT_ARCHIVE_PATH_STYLE=1
# EFFIGENT_ARCHIVE_SSE=none
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
